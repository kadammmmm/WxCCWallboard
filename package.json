{
  "name": "wxcc-wallboard",
  "version": "2.0.0",
  "private": true,
  "description": "Production-grade Webex Contact Center wallboard with real-time updates",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @wxcc-wallboard/api dev\" \"pnpm --filter @wxcc-wallboard/web dev\"",
    "dev:mock": "cross-env MOCK_DATA=true pnpm dev",
    "build": "pnpm --filter @wxcc-wallboard/web build && pnpm --filter @wxcc-wallboard/api build",
    "start": "pnpm --filter @wxcc-wallboard/api start",
    "typecheck": "pnpm --filter @wxcc-wallboard/api typecheck && pnpm --filter @wxcc-wallboard/web typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

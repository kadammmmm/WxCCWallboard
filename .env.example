# --- Runtime ---
PORT=3001
MOCK_DATA=true
WALLBOARD_TITLE=Contact Center Wallboard
WALLBOARD_LOGO_URL=
WALLBOARD_WATERMARK=
SNAPSHOT_INTERVAL_MS=30000
# Optional: require header X-Display-Key or ?key= for /api/snapshot
DISPLAY_KEY=

# --- Alert Thresholds ---
# SLA percentage below which a warning is shown (default 85)
ALERT_SLA_WARN=85
# SLA percentage below which a critical alert is shown (default 70)
ALERT_SLA_CRITICAL=70
# Queue depth above which a warning is shown (default 5)
ALERT_QUEUE_DEPTH_WARN=5
# Queue depth above which a critical alert is shown (default 15)
ALERT_QUEUE_DEPTH_CRITICAL=15
# Longest wait (seconds) above which a warning is shown (default 120)
ALERT_WAIT_WARN=120
# Longest wait (seconds) above which a critical alert is shown (default 300)
ALERT_WAIT_CRITICAL=300

# --- History ---
# Number of snapshots to keep in the ring buffer for sparklines (default 60)
HISTORY_SIZE=60

# --- Webex Service App (required when MOCK_DATA=false) ---
WEBEX_CLIENT_ID=
WEBEX_CLIENT_SECRET=
WEBEX_APP_ID=
WEBEX_ORG_ID=
WEBEX_APPLICATIONS_TOKEN=

# Regional WxCC API base (no trailing slash)
# US: https://api.wxcc-us1.cisco.com  UK: https://api.wxcc-eu1.cisco.com  DE: https://api.wxcc-eu2.cisco.com
WXCC_API_BASE=

# IANA timezone for cumulative stats (e.g. America/New_York, Europe/London)
ORG_TIMEZONE=UTC
# Clock time in ORG_TIMEZONE when a new KPI period starts
STATS_RESET_AT=00:00
# Length of each KPI period in hours (24 = daily)
STATS_INTERVAL_HOURS=24
# Lookback for live agents and in-queue contacts
LIVE_LOOKBACK_HOURS=168
